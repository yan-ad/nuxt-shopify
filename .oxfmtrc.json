{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "useTabs": false,
  "trailingComma": "none",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/.cache/**",
    "**/.data/**",
    "**/.vercel/**",
    "**/coverage/**",
    "**/bun.lock",
    "playground/.shopify/**"
  ]
}
